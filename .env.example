# Postgres
POSTGRES_DB=nomedobancodedados
POSTGRES_USER=usuariodobancodedados
POSTGRES_PASSWORD=senhadobancodedados
DATABASE_URL=urldobancodedados

# Url da Api
BASE_URL=urldaapi

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional: quando não informado, usa BASE_URL (ou localhost em dev)
GOOGLE_CALLBACK_URL=

# JWT
# Gere uma string aleatória (ex: em um gerador de senhas)
JWT_SECRET=

# Front-end
# A URL do app 'web'
FRONTEND_URL=urldofrontend

NODE_ENV=production
NODE_VERSION=20

PORT=3333

# Opcional (recomendado em produção para classificação por ASN/datacenter)
MAXMIND_LICENSE_KEY=

# Tenta garantir City + ASN no boot da API
GEOLITE_DOWNLOAD_ON_BOOT=true

# Se true, falha o boot quando não conseguir preparar GeoLite
GEOLITE_FAIL_FAST=false

# Habilita marcação strict de datacenter (ASN conhecido vira bot)
BOT_STRICT_DATACENTER=true
