FROM node:20-alpine

# 👇 entra direto no backend
WORKDIR /app/api

# Copia manifests do backend
COPY api/package*.json ./
RUN npm install

# Copia o código do backend
COPY api .

# Prisma
RUN npx prisma generate

# Build
RUN npm run build

# Executa o backfill
CMD ["node", "dist/prisma/scripts/backfill-bot-clicks.js"]
